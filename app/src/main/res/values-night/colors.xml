<?xml version="1.0" encoding="utf-8"?>
<!--
  Тёмная палитра. Переопределяем только фоны и контейнеры; брендовые карточки
  (tea_glass_card / table_spoon_card / faceted_glass_card / tea_spoon_card) и
  оранжевый акцент оставляем — они должны оставаться узнаваемыми.

  white/black намеренно НЕ переопределяем: код использует их как "точно белый"/
  "точно чёрный" для отдельных рамок и заливок.
-->
<resources>
    <color name="backgroud_row">#5C3232</color>

    <!-- Основные фоны экранов -->
    <color name="all_background">#121212</color>
    <color name="grey_light">#1F1F1F</color>
    <color name="grey">#A0A0A0</color>

    <!-- TopAppBar / диалоги -->
    <color name="top_app_bar">#1F1F1F</color>
    <color name="top_app_bar_gr">#3A2728</color>

    <!-- Карточки результатов: чуть приглушённые тона -->
    <color name="tea_glass_card">#C29671</color>
    <color name="tea_spoon_card">#A87575</color>
    <color name="table_spoon_card">#86B271</color>
    <color name="faceted_glass_card">#71A0C2</color>
    <color name="header_name_product">#8FBE6A</color>
    <color name="header_product_result">#C04545</color>

    <!-- Мясные «чипы» — насыщеннее, чтобы текст оставался читаемым -->
    <color name="doneness_chip_bg">#5C3F40</color>
    <color name="doneness_chip_text">#F2DCD0</color>

    <color name="dismiss_color">#66FFA4A4</color>
</resources>
