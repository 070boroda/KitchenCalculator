<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ правила для:
   * cloud-backup — Auto Backup в Google Drive (квота 25 МБ на пакет),
   * device-transfer — D2D перенос при настройке нового телефона.
  Содержание: пользовательские рецепты (Room) + DataStore preferences.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="recipe_db" />
        <include domain="database" path="recipe_db-shm" />
        <include domain="database" path="recipe_db-wal" />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />

        <exclude domain="sharedpref" path="appmetrica.xml" />
    </cloud-backup>

    <device-transfer>
        <include domain="database" path="recipe_db" />
        <include domain="database" path="recipe_db-shm" />
        <include domain="database" path="recipe_db-wal" />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
