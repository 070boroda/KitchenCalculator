<?xml version="1.0" encoding="utf-8"?>
<!--
  Правила Auto Backup для Android 11 и ниже.
  Бэкапим Room БД и DataStore. Не бэкапим Crashlytics/Analytics локальные кэши,
  оффлайн-метрики Yandex/AppMetrica — они переинициализируются на новом устройстве.
-->
<full-backup-content>
    <include domain="database" path="recipe_db" />
    <include domain="database" path="recipe_db-shm" />
    <include domain="database" path="recipe_db-wal" />
    <include domain="file" path="datastore/" />
    <include domain="sharedpref" path="." />

    <exclude domain="sharedpref" path="appmetrica.xml" />
</full-backup-content>
